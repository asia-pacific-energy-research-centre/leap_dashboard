# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
.env
*.egg-info/
dist/
build/

# Data inputs — too large / sensitive for version control
data/

# Analytical outputs — dashboard is published from docs/ (GitHub Pages)
outputs/

# Auto-generated config archive (created at runtime by archive_config_dir_once_per_day)
config/.archive/

# Old/archived config files
config/archive/
**/archive

# Jupyter / Spyder
.ipynb_checkpoints/
*.ipynb
temp/
codebase/scrapbook/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# pytest
.pytest_cache/

# Binary / generated formats (not part of the dashboard site)
*.png
*.7z
*.zip
*.xlsx
*.csv
*.pkl
*.dll
*.code-workspace
!.gitkeep
!tests/fixtures/**/*.csv

# Committed dashboard site assets (docs/ = GitHub Pages source)
# HTML, JS, JSON in docs/ are committed; heavy data files inside docs/ are not.
docs/*/supporting_files/
docs/**/*.csv
docs/**/*.xls
docs/**/*.xlsx
docs/**/*.xlsm
docs/*/output_manifest.json
!docs/**/*.json
!docs/**/*.html
!docs/**/*.js
!docs/images/*.png

# Config files committed to this repo
!config/*.json
!config/*.csv
!config/*.xlsx
